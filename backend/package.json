{
  "name": "runtime-visualizer-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot run src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "bun run scripts/check-import-boundaries.ts",
    
    "test:typical": "vitest run --config vitest.config.ts --project backend-unit --project backend-integration --project backend-e2e --passWithNoTests",
    "test:unit": "vitest run --config vitest.config.ts --project backend-unit --passWithNoTests",
    "test:integration": "vitest run --config vitest.config.ts --project backend-integration --passWithNoTests",
    "test:e2e": "vitest run --config vitest.config.ts --project backend-e2e --passWithNoTests",

    "test:acceptance": "vitest run --config vitest.config.ts --project backend-hvut --project backend-hvit --project backend-hve2e --passWithNoTests",
    "test:hvut": "vitest run --config vitest.config.ts --project backend-hvut --passWithNoTests",
    "test:hvit": "vitest run --config vitest.config.ts --project backend-hvit --passWithNoTests",
    "test:hve2e": "vitest run --config vitest.config.ts --project backend-hve2e --passWithNoTests"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "typescript": "^5.6.3",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/ws": "^8.18.1",
    "@amiceli/vitest-cucumber": "^7.0.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}