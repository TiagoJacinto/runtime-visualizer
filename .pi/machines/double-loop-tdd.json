{
  "schemaVersion": 1,
  "id": "double-loop-tdd",
  "version": 1,
  "initial": "scope",
  "terminalStates": ["complete"],
  "context": {
    "selectedExample": null,
    "selectedTest": null,
    "testCommand": null,
    "coverageComplete": false
  },
  "allowedContextPaths": [
    "selectedExample",
    "selectedTest",
    "testCommand",
    "coverageComplete"
  ],
  "profiles": {
    "workflow": {
      "thinking": "high",
      "tools": ["read", "bash", "edit"],
      "skills": ["custom-double-tdd"],
      "instructions": "Work only on one high-value acceptance unit test at a time. Acceptance tests live in tests/acceptance and use @amiceli/vitest-cucumber. Use *.unit.ts files for this loop. Run the configured npm command as a standalone bash call, then request the machine transition alone."
    }
  },
  "states": {
    "scope": {
      "profile": "workflow",
      "instructions": "Read the requested behavior, domain definitions, relevant feature files, existing acceptance tests, and runner configuration. Run npm run test:hvut to establish the baseline. Record the baseline result before selecting an example.",
      "on": {
        "baseline_recorded": {
          "target": "select",
          "guard": {
            "evidence": {
              "path": "bash.command",
              "equals": "npm run test:hvut",
              "source": "runtime"
            }
          }
        }
      }
    },
    "select": {
      "profile": "workflow",
      "instructions": "Select exactly one unhandled acceptance example. Derive expected outcomes from an independent oracle. Set selectedExample, selectedTest, and testCommand with the transition context patch. testCommand must be npm run test:frontend:hvut or npm run test:backend:hvut.",
      "on": {
        "example_selected": {
          "target": "write",
          "guard": {
            "all": [
              { "context": { "path": "selectedExample", "exists": true } },
              { "context": { "path": "selectedTest", "exists": true } },
              {
                "context": {
                  "path": "testCommand",
                  "in": [
                    "npm run test:frontend:hvut",
                    "npm run test:backend:hvut"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "write": {
      "profile": "workflow",
      "instructions": "Write exactly one discoverable high-value unit test in the appropriate tests/acceptance folder. Use @amiceli/vitest-cucumber, invoke the application-level public API, bind every example value, and do not change production behavior. Then run the selected npm unit command.",
      "on": {
        "test_written": {
          "target": "focused_test",
          "guard": {
            "context": { "path": "selectedTest", "exists": true }
          }
        }
      }
    },
    "focused_test": {
      "profile": "workflow",
      "instructions": "Run the selected npm unit command. Classify the result as valid red or valid green at the intended observation. Repair only test plumbing in this state; do not implement production behavior until a valid red is observed.",
      "on": {
        "valid_red": {
          "target": "green",
          "guard": {
            "all": [
              {
                "evidence": {
                  "path": "bash.ok",
                  "equals": false,
                  "source": "runtime"
                }
              },
              {
                "evidence": {
                  "path": "bash.command",
                  "matches": "^npm run test:(frontend|backend):hvut$",
                  "source": "runtime"
                }
              }
            ]
          }
        },
        "valid_green": {
          "target": "suite",
          "guard": {
            "all": [
              {
                "evidence": {
                  "path": "bash.ok",
                  "equals": true,
                  "source": "runtime"
                }
              },
              {
                "evidence": {
                  "path": "bash.command",
                  "matches": "^npm run test:(frontend|backend):hvut$",
                  "source": "runtime"
                }
              }
            ]
          }
        }
      }
    },
    "green": {
      "profile": "workflow",
      "instructions": "Implement the smallest production behavior that satisfies the selected high-value unit test. Run the selected npm unit command after the change. Keep this state active until the focused test is green.",
      "on": {
        "focused_green": {
          "target": "suite",
          "guard": {
            "all": [
              {
                "evidence": {
                  "path": "bash.ok",
                  "equals": true,
                  "source": "runtime"
                }
              },
              {
                "evidence": {
                  "path": "bash.command",
                  "matches": "^npm run test:(frontend|backend):hvut$",
                  "source": "runtime"
                }
              }
            ]
          }
        }
      }
    },
    "suite": {
      "profile": "workflow",
      "instructions": "Run npm run test:hvut and compare it with the baseline. Reconcile the acceptance inventory. Set coverageComplete to true only when every requested high-value unit example is complete and the full unit suite is green.",
      "on": {
        "suite_green": {
          "target": "select",
          "guard": {
            "all": [
              {
                "evidence": {
                  "path": "bash.ok",
                  "equals": true,
                  "source": "runtime"
                }
              },
              {
                "evidence": {
                  "path": "bash.command",
                  "equals": "npm run test:hvut",
                  "source": "runtime"
                }
              },
              {
                "context": {
                  "path": "coverageComplete",
                  "equals": false
                }
              }
            ]
          }
        },
        "suite_failed": {
          "target": "green",
          "guard": {
            "all": [
              {
                "evidence": {
                  "path": "bash.ok",
                  "equals": false,
                  "source": "runtime"
                }
              },
              {
                "evidence": {
                  "path": "bash.command",
                  "equals": "npm run test:hvut",
                  "source": "runtime"
                }
              }
            ]
          }
        },
        "coverage_ready": {
          "target": "suite",
          "guard": {
            "all": [
              {
                "evidence": {
                  "path": "bash.ok",
                  "equals": true,
                  "source": "runtime"
                }
              },
              {
                "evidence": {
                  "path": "bash.command",
                  "equals": "npm run test:hvut",
                  "source": "runtime"
                }
              },
              {
                "context": {
                  "path": "coverageComplete",
                  "equals": false
                }
              }
            ]
          },
          "contextPatch": { "coverageComplete": true }
        },
        "complete": {
          "target": "complete",
          "guard": {
            "all": [
              {
                "evidence": {
                  "path": "bash.ok",
                  "equals": true,
                  "source": "runtime"
                }
              },
              {
                "evidence": {
                  "path": "bash.command",
                  "equals": "npm run test:hvut",
                  "source": "runtime"
                }
              },
              {
                "context": {
                  "path": "coverageComplete",
                  "equals": true
                }
              }
            ]
          }
        }
      }
    },
    "complete": {
      "terminal": true,
      "instructions": "Report the completed high-value unit-test inventory, red proofs, implementation changes, and final npm commands. Do not begin refactoring in this machine."
    }
  }
}
