{
  "name": "runtime-visualizer",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "browser"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bun install --frozen-lockfile",
    "setup": "bun run bootstrap",
    "update": "bun run bootstrap",
    "server": "bun run dev",
    "frontend:install:playwright": "cd browser && bunx playwright install chromium",
    "test": "bun run lint && bun run backend:typecheck && bun run lint:boundaries && bun run contracts:typecheck && bun run backend:test:unit && bun run backend:test:integration && bun run backend:test:durable && bun run backend:test:hvut && bun run backend:test:hvit && bun run backend:test:hve2e && bun run frontend:test:hvut && bun run frontend:test:hvit && bun run frontend:test:hve2e && bun run contracts:test:unit",
    "lint": "oxlint browser/src backend/src",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "lint:boundaries": "bun run --filter runtime-visualizer-backend lint:boundaries",
    "coverage": "bun run backend:test:coverage && bun run frontend:test:coverage && bun run contracts:test:coverage",
    "coverage:layers": "bun run backend:test:coverage:unit && bun run backend:test:coverage:integration && bun run frontend:test:coverage:hvut && bun run contracts:test:coverage:unit",
    "quality:policy-test": "node --test quality/dynamic-policy.test.mjs",
    "quality:static": "bun run quality:policy-test && bun run backend:typecheck && bun run lint:boundaries && bun run contracts:typecheck && bun run frontend:build && bun run clone-check",
    "quality:acceptance": "bun run backend:test:hvut && bun run frontend:test:hvut",
    "quality:regression": "bun run backend:test:unit && bun run backend:test:integration && bun run backend:test:durable && bun run contracts:test:unit",
    "quality:coverage": "bun run coverage && bun run coverage:layers && bun run quality:coverage-policy",
    "quality:coverage-policy": "bun run scripts/verify-coverage-policy.mjs",
    "quality": "bun run quality:policy-test && bun run test && bun run frontend:build && bun run coverage && bun run coverage:layers && bun run quality:coverage-policy && bun run clone-check",
    "check:maintainability": "bun run lint && bun run coverage",
    "prepush": "bun run lint && bun run backend:typecheck && bun run frontend:build && bun run backend:test:unit && bun run backend:test:durable && bun run backend:test:acceptance && bun run frontend:test:hvut && bun run clone-check",
    "clone-check": "jscpd backend/src browser/src",
    "clone-instances": "bun run scripts/clone-instances.ts",
    "prototype:workspace-management": "bun run --filter runtime-visualizer-browser dev",
    "cibuild": "bun run quality",
    "prepare": "lefthook install",
    "dev": "bun run --parallel backend:dev frontend:dev",
    "backend:start": "bun run --filter runtime-visualizer-backend start",
    "backend:dev": "bun run --filter runtime-visualizer-backend dev",
    "backend:typecheck": "bun run --filter runtime-visualizer-backend typecheck",
    "contracts:typecheck": "bun run --filter @runtime-visualizer/contracts typecheck",
    "contracts:test:unit": "bun run --filter @runtime-visualizer/contracts test:unit",
    "contracts:test:coverage": "bun run --filter @runtime-visualizer/contracts test:coverage",
    "contracts:test:coverage:unit": "bun run --filter @runtime-visualizer/contracts test:coverage:unit",
    "backend:test:typical": "bun run --filter runtime-visualizer-backend test:typical",
    "backend:test:unit": "bun run --filter runtime-visualizer-backend test:unit",
    "backend:test:integration": "bun run --filter runtime-visualizer-backend test:integration",
    "backend:test:e2e": "bun run --filter runtime-visualizer-backend test:e2e",
    "backend:test:durable": "bun run --filter runtime-visualizer-backend test:durable",
    "backend:test:coverage": "bun run --parallel --filter runtime-visualizer-backend test:coverage",
    "backend:test:coverage:unit": "bun run --parallel --filter runtime-visualizer-backend test:coverage:unit",
    "backend:test:coverage:integration": "bun run --parallel --filter runtime-visualizer-backend test:coverage:integration",
    "backend:test:coverage:acceptance": "bun run --parallel --filter runtime-visualizer-backend test:coverage:acceptance",
    "backend:test:acceptance": "bun run --filter runtime-visualizer-backend test:acceptance",
    "backend:test:hvut": "bun run --filter runtime-visualizer-backend test:hvut",
    "backend:test:hvit": "bun run --filter runtime-visualizer-backend test:hvit",
    "backend:test:hve2e": "bun run --filter runtime-visualizer-backend test:hve2e",
    "frontend:dev": "bun run --filter runtime-visualizer-browser dev",
    "frontend:build": "bun run --filter runtime-visualizer-browser build",
    "frontend:lint": "bun run --filter runtime-visualizer-browser lint",
    "frontend:preview": "bun run --filter runtime-visualizer-browser preview",
    "frontend:test:typical": "bun run --filter runtime-visualizer-browser test:typical",
    "frontend:test:unit": "bun run --filter runtime-visualizer-browser test:unit",
    "frontend:test:integration": "bun run --filter runtime-visualizer-browser test:integration",
    "frontend:test:e2e": "bun run --filter runtime-visualizer-browser test:e2e",
    "frontend:test:coverage": "bun run --parallel --filter runtime-visualizer-browser test:coverage",
    "frontend:test:coverage:unit": "bun run --parallel --filter runtime-visualizer-browser test:coverage:unit",
    "frontend:test:coverage:hvut": "bun run --parallel --filter runtime-visualizer-browser test:coverage:hvut",
    "frontend:test:coverage:integration": "bun run --parallel --filter runtime-visualizer-browser test:coverage:integration",
    "frontend:test:coverage:acceptance": "bun run --parallel --filter runtime-visualizer-browser test:coverage:acceptance",
    "frontend:test:acceptance": "bun run --filter runtime-visualizer-browser test:acceptance",
    "frontend:test:hvut": "bun run --filter runtime-visualizer-browser test:hvut",
    "frontend:test:hvit": "bun run --filter runtime-visualizer-browser test:hvit",
    "frontend:test:hve2e": "bun run --filter runtime-visualizer-browser test:hve2e",
    "check": "ultracite check browser/src backend/src",
    "fix": "ultracite fix browser/src backend/src"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "dependency-cruiser": "^18.2.0",
    "eslint-plugin-sonarjs": "^3.0.7",
    "fallow": "3.15.0",
    "jscpd": "5.0.14",
    "lefthook": "2.1.9",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "ts-api-utils": "^2.5.0",
    "ultracite": "7.11.0",
    "zod": "^4.4.3"
  }
}
