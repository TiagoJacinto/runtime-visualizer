{
  "name": "runtime-visualizer",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "browser"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bun install --frozen-lockfile",
    "setup": "bun run bootstrap",
    "update": "bun run bootstrap",
    "test": "bun run test:pi-extension && bun run lint && bun run frontend:test:unit && bun run frontend:test:integration && bun run frontend:test:acceptance && bun run frontend:build",
    "lint": "oxlint browser/src",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "test:pi-extension": "bun test ./.pi/extensions/tests",
    "quality:static": "bun run test:pi-extension && bun run frontend:build && bun run clone-check",
    "quality:acceptance": "bun run frontend:test:acceptance",
    "quality:regression": "bun run frontend:test:unit && bun run frontend:test:integration",
    "quality": "bun run lint && bun run quality:static && bun run quality:acceptance && bun run quality:regression",
    "prepush": "bun run lint && bun run frontend:build && bun run frontend:test:unit && bun run frontend:test:integration && bun run frontend:test:acceptance && bun run clone-check",
    "clone-check": "jscpd browser/src",
    "clone-instances": "bun run scripts/clone-instances.ts",
    "prototype:workspace-management": "bun run --filter runtime-visualizer-browser dev",
    "cibuild": "bun run quality",
    "prepare": "lefthook install",
    "dev": "bun run frontend:dev",
    "dev:https": "bash scripts/dev-tailscale.sh",
    "frontend:dev": "bun run --filter runtime-visualizer-browser dev",
    "frontend:build": "bun run --filter runtime-visualizer-browser build",
    "frontend:lint": "bun run --filter runtime-visualizer-browser lint",
    "frontend:preview": "bun run --filter runtime-visualizer-browser preview",
    "frontend:test:typical": "bun run --filter runtime-visualizer-browser test:typical",
    "frontend:test:unit": "bun run --filter runtime-visualizer-browser test:unit",
    "frontend:test:integration": "bun run --filter runtime-visualizer-browser test:integration",
    "frontend:test:integration:composition": "bun run --filter runtime-visualizer-browser test:integration:composition",
    "frontend:test:integration:incoming": "bun run --filter runtime-visualizer-browser test:integration:incoming",
    "frontend:test:integration:outgoing-managed": "bun run --filter runtime-visualizer-browser test:integration:outgoing-managed",
    "frontend:test:integration:outgoing-unmanaged": "bun run --filter runtime-visualizer-browser test:integration:outgoing-unmanaged",
    "frontend:test:acceptance": "bun run --filter runtime-visualizer-browser test:acceptance",
    "frontend:test:hvut": "bun run --filter runtime-visualizer-browser test:hvut",
    "frontend:test:hvit": "bun run --filter runtime-visualizer-browser test:hvit",
    "check": "ultracite check browser/src",
    "fix": "ultracite fix browser/src"
  },
  "dependencies": {
    "pi-typesafe": "^0.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "eslint-plugin-sonarjs": "^3.0.7",
    "fallow": "3.15.0",
    "jscpd": "5.0.14",
    "lefthook": "2.1.9",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "ts-api-utils": "^2.5.0",
    "typescript": "5.9.3",
    "ultracite": "7.11.0"
  }
}
