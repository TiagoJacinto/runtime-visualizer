# SSSF environment. Copy to .env at the target repo root and fill in.
#
# The default roster uses Pi's OpenCode Go model:
#   opencode-go/mimo-v2.5
#
# Authenticate once in Pi with `/login opencode-go`.
# No OpenRouter API key is required.

# Optional provider overrides for custom roster entries:
# FIREWORKS_API_KEY=
# OPENAI_API_KEY=

# Optional overrides
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name
