{
  "name": "runtime-visualizer-browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test:typical": "vitest run --config vitest.config.ts --project browser-unit --project browser-integration --project browser-e2e --passWithNoTests",
    "test:unit": "vitest run --config vitest.config.ts --project browser-unit --passWithNoTests",
    "test:integration": "vitest run --config vitest.config.ts --project browser-integration --passWithNoTests",
    "test:e2e": "vitest run --config vitest.config.ts --project browser-e2e --passWithNoTests",
    "test:acceptance": "bun run test:hvut && bun run test:hvit && bun run test:hve2e",
    "test:hvut": "vitest run --config vitest.config.ts --project browser-hvut --passWithNoTests",
    "test:hvit": "vitest run --config vitest.config.ts --project browser-hvit --passWithNoTests",
    "test:hve2e": "bddgen --config playwright.config.ts && playwright test --config playwright.config.ts --pass-with-no-tests",
    "test:hve2e:ui": "bddgen --config playwright.config.ts && playwright test --config playwright.config.ts --ui --pass-with-no-tests",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --passWithNoTests",
    "test:coverage:unit": "vitest run --config vitest.config.ts --coverage --maxWorkers=1 --project browser-unit --coverage.thresholds.lines=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0 --passWithNoTests",
    "test:coverage:integration": "vitest run --config vitest.config.ts --coverage --maxWorkers=1 --project browser-integration --project browser-e2e --coverage.thresholds.lines=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0 --passWithNoTests",
    "test:coverage:acceptance": "vitest run --config vitest.config.ts --coverage --maxWorkers=1 --project browser-hvut --project browser-hvit --coverage.thresholds.lines=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0 --passWithNoTests"
  },
  "dependencies": {
    "@runtime-visualizer/contracts": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.11.6",
    "dompurify": "^3.4.12",
    "elkjs": "^0.12.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@babel/core": "^7.29.7",
    "@frontman-ai/vite": "^1.0.3",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "playwright-bdd": "^9.2.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
